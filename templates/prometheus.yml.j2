# GENERATED by tools/render.py from network.yaml - do not edit by hand.
global:
  scrape_interval: 15s
scrape_configs:
  - job_name: orderers
    static_configs:
      - targets: [{% for od in m.orderer_org.orderers %}"{{ od.host }}:{{ od.ops_port }}"{{ ", " if not loop.last }}{% endfor %}]
{% for org in m.orgs %}
  - job_name: peers-{{ org.lower }}
    static_configs:
      - targets: [{% for n in org.nodes if n.role != 'vscc' %}"{{ n.host }}:{{ n.ops_port }}"{{ ", " if not loop.last }}{% endfor %}]
        labels:
          org: {{ org.name }}
  - job_name: ca-{{ org.lower }}
    static_configs:
      - targets: ["{{ org.ca.container }}:{{ org.ca.ops_port }}"]
{% endfor %}
