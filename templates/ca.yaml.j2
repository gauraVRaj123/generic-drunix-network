{% import '_macros.j2' as u with context %}
# GENERATED by tools/render.py from network.yaml - do not edit by hand.
# One Fabric CA per organisation (serves as both identity CA and TLS CA).
# The bootstrap admin password is read from a docker secret, so it appears in
# neither the compose file, the container environment nor `docker inspect`.
networks:
  net:
    name: {{ m.network }}
    external: true

secrets:
{% for org in cas %}
  ca_{{ org.lower }}_admin:
    file: ../../secrets/ca-{{ org.lower }}.pw
{% endfor %}

services:
{% for org in cas %}
  {{ org.ca.container }}:
    container_name: {{ org.ca.container }}
    image: {{ m.images.ca }}
    restart: unless-stopped
    labels:
      service: {{ m.name }}
    environment:
      - FABRIC_CA_HOME=/etc/hyperledger/fabric-ca-server
      - FABRIC_CA_SERVER_CA_NAME={{ org.ca.name }}
      - FABRIC_CA_SERVER_TLS_ENABLED=true
      - FABRIC_CA_SERVER_PORT={{ org.ca.port }}
      - FABRIC_CA_SERVER_CSR_HOSTS={{ org.ca.container }},localhost{{ "," ~ org.ca.host if org.ca.host != "localhost" }}
      - FABRIC_CA_SERVER_OPERATIONS_LISTENADDRESS=0.0.0.0:{{ org.ca.ops_port }}
      - FABRIC_CA_SERVER_METRICS_PROVIDER=prometheus
    command: sh -c 'fabric-ca-server start -b "admin:$$(cat /run/secrets/ca_{{ org.lower }}_admin)"'
    secrets:
      - ca_{{ org.lower }}_admin
    volumes:
      - ../../organizations/fabric-ca/{{ org.lower }}:/etc/hyperledger/fabric-ca-server
    ports:
      - "{{ org.ca.port }}:{{ org.ca.port }}"
    networks:
      - net
{{ u.tcp_health('127.0.0.1', org.ca.port, '10s') }}
{{ u.logging() }}
{% endfor %}
