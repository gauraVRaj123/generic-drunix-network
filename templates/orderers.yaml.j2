{% import '_macros.j2' as u with context %}
{% set oo = m.orderer_org %}
# GENERATED by tools/render.py from network.yaml - do not edit by hand.
# Raft ordering service ({{ oo.orderers | length }} consenter(s)). Channels are created with the
# channel-participation API (no system channel); WAL, snapshots and ledger live on named volumes.
networks:
  net:
    name: {{ m.network }}
    external: true

volumes:
{% for od in oo.orderers %}
  {{ od.volume }}:
    name: {{ od.volume }}
{% endfor %}

services:
{% for od in oo.orderers %}
  {{ od.host }}:
    container_name: {{ od.container }}
    image: {{ m.images.orderer }}
    restart: unless-stopped
    labels:
      service: {{ m.name }}
    environment:
      - FABRIC_LOGGING_SPEC={{ m.logging.level }}
      - ORDERER_GENERAL_LISTENADDRESS=0.0.0.0
      - ORDERER_GENERAL_LISTENPORT={{ od.port }}
      - ORDERER_GENERAL_LOCALMSPID={{ oo.msp_id }}
      - ORDERER_GENERAL_LOCALMSPDIR=/var/hyperledger/orderer/msp
      - ORDERER_GENERAL_BOOTSTRAPMETHOD=none
      - ORDERER_GENERAL_MVCCENABLED=false
      - ORDERER_GENERAL_MAXBATCHSIZE=5000
      - ORDERER_GENERAL_BLOCKCUTTIME=2
      - ORDERER_GENERAL_TLS_ENABLED=true
      - ORDERER_GENERAL_TLS_PRIVATEKEY=/var/hyperledger/orderer/tls/server.key
      - ORDERER_GENERAL_TLS_CERTIFICATE=/var/hyperledger/orderer/tls/server.crt
      - ORDERER_GENERAL_TLS_ROOTCAS=[/var/hyperledger/orderer/tls/ca.crt]
      - ORDERER_GENERAL_CLUSTER_CLIENTCERTIFICATE=/var/hyperledger/orderer/tls/server.crt
      - ORDERER_GENERAL_CLUSTER_CLIENTPRIVATEKEY=/var/hyperledger/orderer/tls/server.key
      - ORDERER_GENERAL_CLUSTER_ROOTCAS=[/var/hyperledger/orderer/tls/ca.crt]
      - ORDERER_CHANNELPARTICIPATION_ENABLED=true
      - ORDERER_ADMIN_TLS_ENABLED=true
      - ORDERER_ADMIN_TLS_CERTIFICATE=/var/hyperledger/orderer/tls/server.crt
      - ORDERER_ADMIN_TLS_PRIVATEKEY=/var/hyperledger/orderer/tls/server.key
      - ORDERER_ADMIN_TLS_ROOTCAS=[/var/hyperledger/orderer/tls/ca.crt]
      - ORDERER_ADMIN_TLS_CLIENTROOTCAS=[/var/hyperledger/orderer/tls/ca.crt]
      - ORDERER_ADMIN_LISTENADDRESS=0.0.0.0:{{ od.admin_port }}
      - ORDERER_OPERATIONS_LISTENADDRESS=0.0.0.0:{{ od.ops_port }}
      - ORDERER_METRICS_PROVIDER=prometheus
      # persistent storage
      - ORDERER_SNAPSHOTINTERVAL=16777216
      - ORDERER_CONSENSUS_WALDIR=/var/hyperledger/production/orderer/etcdraft/wal
      - ORDERER_CONSENSUS_SNAPDIR=/var/hyperledger/production/orderer/etcdraft/snapshot
      - ORDERER_FILELEDGER_LOCATION=/var/hyperledger/production/orderer/blocks
      - ORDERER_FILELEDGER_KVSTORE=/var/hyperledger/production/orderer/kvstore
      - ORDERER_FILELEDGER_KVSTORECACHESIZE=2147483
      - ORDERER_FILELEDGER_ORGBLOCKCACHESIZE=107374
    working_dir: /root
    command: orderer
    volumes:
      - ../../organizations/ordererOrganizations/{{ oo.domain }}/orderers/{{ od.host }}/msp:/var/hyperledger/orderer/msp:ro
      - ../../organizations/ordererOrganizations/{{ oo.domain }}/orderers/{{ od.host }}/tls:/var/hyperledger/orderer/tls:ro
      - {{ od.volume }}:/var/hyperledger/production/orderer
    ports:
      - "{{ od.port }}:{{ od.port }}"
      - "{{ od.admin_port }}:{{ od.admin_port }}"
      - "{{ od.ops_port }}:{{ od.ops_port }}"
    networks:
      - net
{{ u.extra_hosts(od.address) }}
{{ u.tcp_health('127.0.0.1', od.port) }}
{{ u.logging() }}
{% endfor %}
