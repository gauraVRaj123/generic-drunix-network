        Type: Signature
        Rule: "OR('{{ oo.msp_id }}.member')"
      Admins:
        Type: Signature
        Rule: "OR('{{ oo.msp_id }}.admin')"
    OrdererEndpoints:
{% for od in oo.orderers %}
      - {{ od.host }}:{{ od.port }}
{% endfor %}
{% for org in m.orgs %}
  - &{{ org.name }}
    Name: {{ org.msp_id }}
    ID: {{ org.msp_id }}
    MSPDir: ../../organizations/peerOrganizations/{{ org.domain }}/msp
    Policies:
      Readers:
        Type: Signature
        Rule: "OR('{{ org.msp_id }}.admin', '{{ org.msp_id }}.peer', '{{ org.msp_id }}.client')"
      Writers:
        Type: Signature
        Rule: "OR('{{ org.msp_id }}.admin', '{{ org.msp_id }}.client', '{{ org.msp_id }}.member')"
      Admins:
        Type: Signature
        Rule: "OR('{{ org.msp_id }}.admin')"
      Endorsement:
        Type: Signature
        Rule: "OR('{{ org.msp_id }}.peer')"
    AnchorPeers:
      - Host: {{ org.nodes[0].host }}
        Port: {{ org.nodes[0].port }}
{% endfor %}

