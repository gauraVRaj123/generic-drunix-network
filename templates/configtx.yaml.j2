{% set oo = m.orderer_org %}
Organizations:
  - &{{ oo.name }}
    Name: {{ oo.msp_id }}
    ID: {{ oo.msp_id }}
    MSPDir: ../../organizations/ordererOrganizations/{{ oo.domain }}/msp
    Policies:
      Readers:
        Type: Signature
        Rule: "OR('{{ oo.msp_id }}.member')"
