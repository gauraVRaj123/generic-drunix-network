# GENERATED by tools/render.py from network.yaml - do not edit by hand.
{% import '_macros.j2' as u with context %}
networks:
  net:
    name: {{ m.network }}
    external: true

secrets:
  grafana_admin:
    file: ../../secrets/grafana-admin.pw

volumes:
  {{ m.name }}_prometheus:
    name: {{ m.name }}_prometheus
  {{ m.name }}_grafana:
    name: {{ m.name }}_grafana

services:
  prometheus:
    container_name: {{ m.name }}-prometheus
    image: {{ m.images.prometheus }}
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.retention.time=30d
    volumes:
      - ../monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - {{ m.name }}_prometheus:/prometheus
    ports:
      - "{{ m.monitoring.prometheus_port }}:9090"
    networks:
      - net
{# monitoring runs on the first organization's host: only nodes on OTHER hosts need an address mapping #}
{{ u.extra_hosts(m.orgs[0].host) }}
    logging:
      driver: json-file
      options:
        max-size: "{{ m.logging.max_size }}"
        max-file: "{{ m.logging.max_files }}"

  grafana:
    container_name: {{ m.name }}-grafana
    image: {{ m.images.grafana }}
    restart: unless-stopped
    depends_on:
      - prometheus
    environment:
      - GF_SECURITY_ADMIN_USER=admin
      - GF_SECURITY_ADMIN_PASSWORD__FILE=/run/secrets/grafana_admin
      - GF_USERS_ALLOW_SIGN_UP=false
    secrets:
      - grafana_admin
    volumes:
      - ../monitoring/grafana-datasource.yml:/etc/grafana/provisioning/datasources/datasource.yml:ro
      - ../monitoring/grafana-dashboards.yml:/etc/grafana/provisioning/dashboards/dashboards.yml:ro
      - ../monitoring/dashboards:/etc/grafana/dashboards:ro
      - {{ m.name }}_grafana:/var/lib/grafana
    ports:
      - "{{ m.monitoring.grafana_port }}:3000"
    networks:
      - net
    logging:
      driver: json-file
      options:
        max-size: "{{ m.logging.max_size }}"
        max-file: "{{ m.logging.max_files }}"
