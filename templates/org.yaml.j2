{% import '_macros.j2' as u with context %}
{% set peer_dir = '../../organizations/peerOrganizations/' ~ org.domain ~ '/peers' %}
{% set orderer_tls_ca = '../../organizations/ordererOrganizations/' ~ m.orderer_org.domain ~ '/tlsca/tlsca.' ~ m.orderer_org.domain ~ '-cert.pem' %}
{% set cps = org.nodes | selectattr('role', 'eq', 'cp') | list %}
{% set by_id = {} %}
{% for n in org.nodes %}{% set _ = by_id.update({n.id: n}) %}{% endfor %}
# GENERATED by tools/render.py from network.yaml - do not edit by hand.
# {{ org.name }}: {{ org.counts.committing }} committing, {{ org.counts.lite }} lite, {{ org.counts.vscc }} vscc peer(s).
# Each committing peer (CP) owns a YugabyteDB + KeyDB; lite peers (LP) and VSCC
# services attached to it share that state DB. All state is on named volumes.
networks:
  net:
    name: {{ m.network }}
    external: true

volumes:
{% for n in org.nodes if n.role != 'vscc' %}
  {{ n.data_volume }}:
    name: {{ n.data_volume }}
{% endfor %}
{% for c in cps %}
  {{ c.yb_volume }}:
    name: {{ c.yb_volume }}
  {{ c.keydb_volume }}:
    name: {{ c.keydb_volume }}
{% endfor %}

services:
{% for c in cps %}
  {{ c.yugabyte }}:
    container_name: {{ c.yugabyte }}
    hostname: {{ c.yugabyte }}
    image: {{ m.images.yugabyte }}
    restart: unless-stopped
    # fixed hostname + advertise address: yugabyted stores its address in the data volume,
    # so it must stay stable across container re-creation
    command: ["bin/yugabyted", "start", "--background=false", "--base_dir=/data/yb", "--advertise_address={{ c.yugabyte }}"]
    volumes:
      - {{ c.yb_volume }}:/data/yb
    networks:
      - net
{{ u.tcp_health(c.yugabyte, 5433, '120s') }}
{{ u.logging() }}

  {{ c.keydb }}:
    container_name: {{ c.keydb }}
    image: {{ m.images.keydb }}
    restart: unless-stopped
    command: ["keydb-server", "/etc/keydb/keydb.conf", "--appendonly", "yes"]
    volumes:
      - {{ c.keydb_volume }}:/data
    networks:
      - net
    healthcheck:
      test: ["CMD", "keydb-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 6
{{ u.logging() }}

{% endfor %}
{% for n in org.nodes %}
{% set cp = by_id[n.cp] if n.role != 'cp' else n %}
{% set image = m.images.vscc if n.role == 'vscc' else m.images.peer %}
  {{ n.host }}:
    container_name: {{ n.container }}
    image: {{ image }}
    restart: unless-stopped
    labels:
      service: {{ m.name }}
      role: {{ n.role }}
    depends_on:
      {{ cp.yugabyte }}:
        condition: service_healthy
      {{ cp.keydb }}:
        condition: service_healthy
    environment:
      - FABRIC_CFG_PATH=/etc/hyperledger/peercfg
      - FABRIC_LOGGING_SPEC={{ m.logging.level }}
      - CORE_PEER_TLS_ENABLED=true
      - CORE_PEER_PROFILE_ENABLED=false
      - CORE_PEER_TLS_CERT_FILE=/etc/hyperledger/fabric/tls/server.crt
      - CORE_PEER_TLS_KEY_FILE=/etc/hyperledger/fabric/tls/server.key
      - CORE_PEER_TLS_ROOTCERT_FILE=/etc/hyperledger/fabric/tls/ca.crt
      - CORE_PEER_LOCALMSPID={{ org.msp_id }}
      - CORE_PEER_MSPCONFIGPATH=/etc/hyperledger/fabric/msp
      - CORE_METRICS_PROVIDER=prometheus
      # state database (per committing peer) and transient-store KV
      - CORE_LEDGER_STATE_STATEDATABASE=sqldb
      - CORE_LEDGER_STATE_SQLDBCONFIG_ADDRESS={{ cp.yugabyte }}
      - CORE_LEDGER_STATE_SQLDBCONFIG_PORT=5433
      - CORE_LEDGER_STATE_SQLDBCONFIG_DBNAME=yugabyte
      - CORE_LEDGER_STATE_SQLDBCONFIG_USER=yugabyte
      - CORE_LEDGER_STATE_SQLDBCONFIG_PASSWORD=yugabyte
      - CORE_LEDGER_STATE_SQLDBCONFIG_SSLMODE=disable
      - CORE_LEDGER_STATE_SQLDBCONFIG_PREPARESTATEMENT=true
      - CORE_LEDGER_STATE_SQLDBCONFIG_BATCHSIZE=100
      - CORE_LEDGER_STATE_SQLDBCONFIG_MAXIDLECONNS=50
      - CORE_LEDGER_STATE_SQLDBCONFIG_MAXOPENCONNS=50
      - CORE_LEDGER_STATE_SQLDBCONFIG_CONNMAXLIFETIME=60m
      - CORE_PEER_KVSTORE_ENABLED=true
      - CORE_PEER_KVSTORE_ADDRESS={{ cp.keydb }}:6379
      - CORE_PEER_KVSTORE_REPLICAADDRESS={{ cp.keydb }}:6379
      - CORE_PEER_KVSTORE_PASSWORD=
      - CORE_PEER_KVSTORE_POOLFIFO=true
      - CORE_PEER_KVSTORE_POOLSIZE=30
      - CORE_PEER_KVSTORE_MINIDLECONNS=30
      - CORE_PEER_KVSTORE_MAXACTIVECONNS=30
      - CORE_PEER_KVSTORE_CONNMAXIDLETIME=10m
      - CORE_PEER_KVSTORE_DB=0
{% if n.role == 'vscc' %}
      # VSCC validation service: reuses the identity of the committing peer it serves
      - CORE_PEER_ID={{ cp.host }}
      - CORE_PEER_ADDRESS={{ n.host }}:{{ n.port }}
      - CORE_PEER_LISTENADDRESS={{ n.host }}:{{ n.port }}
      - CORE_PEER_VSCCSERVER_CONFIGTXCHANNELNAME=config-tx-channel
      - CORE_PEER_VSCCSERVER_CONFIGTXCHANNELTIMEOUT=6s
      - CORE_PEER_VALIDATORPOOLSIZE=128
{% else %}
      - CORE_PEER_ID={{ n.host }}
      - CORE_PEER_ADDRESS={{ n.host }}:{{ n.port }}
      - CORE_PEER_LISTENADDRESS=0.0.0.0:{{ n.port }}
      - CORE_PEER_CHAINCODEADDRESS={{ n.host }}:{{ n.cc_port }}
      - CORE_PEER_CHAINCODELISTENADDRESS=0.0.0.0:{{ n.cc_port }}
      - CORE_PEER_GOSSIP_BOOTSTRAP={{ n.host }}:{{ n.port }}
      - CORE_PEER_GOSSIP_EXTERNALENDPOINT={{ n.host }}:{{ n.port }}
      - CORE_PEER_GOSSIP_ORGLEADER=true
      - CORE_PEER_GOSSIP_STATE_ENABLED=false
      - CORE_PEER_GOSSIP_USELEADERELECTION=false
      - CORE_OPERATIONS_LISTENADDRESS=0.0.0.0:{{ n.ops_port }}
      - CORE_CHAINCODE_EXECUTETIMEOUT=300s
      - CHAINCODE_AS_A_SERVICE_BUILDER_CONFIG={"peername":"{{ n.id }}{{ org.lower }}"}
{% endif %}
{% if n.role == 'lp' %}
      # lite peer: endorses/installs chaincode, hands commits to its committing peer
      - CORE_VM_ENDPOINT=unix:///host/var/run/docker.sock
      - CORE_VM_DOCKER_HOSTCONFIG_NETWORKMODE={{ m.network }}
      - CORE_PEER_DELIVERYCLIENT_BLOCKGOSSIPENABLED=false
      - CORE_PEER_LITEPEER_ENABLED=true
      - CORE_PEER_COMMITTINGPEER_ID={{ cp.host }}
      - CORE_PEER_COMMITTINGPEER_ENDPOINT=dns:///{{ cp.host }}:{{ cp.port }}
      - CORE_PEER_COMMITTINGPEER_TLSCERTPATH=/etc/hyperledger/fabric/cp/tls/ca.crt
      - CORE_PEER_COMMITTINGPEER_FORWARDCOMMITSTATUSREQUESTS_ENABLED=true
{% elif n.role == 'cp' %}
      # committing peer: pulls blocks from the orderers, validates through its VSCC
      - CORE_PEER_DELIVERYCLIENT_BLOCKGOSSIPENABLED=true
      - CORE_PEER_VSCCSERVICE_ENABLED=true
      - CORE_PEER_VSCCSERVICE_TLS_ENABLED=true
      - CORE_PEER_VSCCSERVICE_INGRESSENDPOINT={{ n.host }}
      - CORE_PEER_VSCCSERVICE_ENDPOINT={{ by_id[n.vscc].host }}:{{ by_id[n.vscc].port }}
      - CORE_PEER_VSCCSERVICE_BATCHSIZE=10
{% endif %}
    working_dir: /root
    command: {{ 'vscc node start' if n.role == 'vscc' else 'peer node start' }}
    volumes:
      - {{ peer_dir }}/{{ (cp.host if n.role == 'vscc' else n.host) }}:/etc/hyperledger/fabric
      - ../peercfg:/etc/hyperledger/peercfg:ro
      - {{ orderer_tls_ca }}:/etc/hyperledger/fabric/tls/orderer.crt:ro
{% if n.role != 'vscc' %}
      - {{ n.data_volume }}:/var/hyperledger/production
{% endif %}
{% if n.role == 'lp' %}
      - {{ peer_dir }}/{{ cp.host }}/tls:/etc/hyperledger/fabric/cp/tls:ro
      - ${DOCKER_SOCK:-/var/run/docker.sock}:/host/var/run/docker.sock
{% endif %}
    ports:
      - "{{ n.port }}:{{ n.port }}"
{% if n.role != 'vscc' %}
      - "{{ n.ops_port }}:{{ n.ops_port }}"
{% endif %}
    networks:
      - net
{{ u.extra_hosts(org.host) }}
{{ u.tcp_health(n.host, n.port) }}
{{ u.logging() }}

{% endfor %}
